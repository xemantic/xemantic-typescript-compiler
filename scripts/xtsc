#!/usr/bin/env bash
#
# xtsc - the guarded launcher.
#
# Runs the TypeScript compiler on the JVM, using the JDK 25 AOT cache when - and
# ONLY when - that cache's provenance is fully verified against the classpath it
# was trained from. See scripts/xtsc-aot-lib.sh for the contract and
# docs/perf/aot-cache.md for the measurements and the residual risks.
#
#   scripts/xtsc --noEmit /path/to/project        # normal use
#   scripts/xtsc --serve --socket /tmp/x.sock     # run the compile server
#   scripts/xtsc --daemon --socket /tmp/x.sock …  # send a request to one
#   scripts/xtsc-aot train /path/to/project       # create the cache
#   XTSC_AOT=off scripts/xtsc ...                 # never use a cache
#   XTSC_AOT_VERBOSE=1 scripts/xtsc ...           # print the decision to stderr
#
# Environment: XTSC_CP (explicit classpath), XTSC_HOME (a distribution root with
# lib/*.jar), XTSC_AOT_DIR (cache location, default $XDG_CACHE_HOME/xtsc),
# XTSC_JAVA (java binary), XTSC_JAVA_OPTS (extra JVM flags, default -Xmx4g).
set -euo pipefail

XTSC_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/xtsc-aot-lib.sh
. "$XTSC_SCRIPT_DIR/xtsc-aot-lib.sh"

# The DISPATCHING entry point, not the plain one-shot `…compiler.MainKt`: its
# `main` is a strict superset that adds `--serve` (run the compile server) and
# `--daemon` (send the request to one, falling back to compiling in-process) and
# otherwise delegates to `…compiler.main(args)` verbatim. Round 839 found the
# launcher could not reach either mode; its `--serve` arm had to be run by
# invoking `java` by hand.
#
# This constant is inside the AOT fingerprint (`mainclass` in
# xtsc_fingerprint_block), so it MUST stay identical to scripts/xtsc-aot's —
# a half-swap makes every launch read `SKIP no-cache-file` and silently run
# uncached forever. AotCacheGuardTest pins the two against each other.
XTSC_MAIN_CLASS="com.xemantic.typescript.compiler.server.XtscMainKt"

# ---------------------------------------------------------------------------
# (WARM.20) THE CLIENT ARM  --  a `--daemon` request goes through the NATIVE
# client when there is one, and through the JVM dispatcher when there is not.
# ---------------------------------------------------------------------------
#
# Round 872 measured the fixed per-invocation cost of every client arm that
# exists, against one warm daemon, with a request the server refuses in constant
# time: JVM dispatcher 287 ms, thin JVM client 278 ms (the module split buys
# NOTHING by itself - the cost is the JVM, not the compiler jar), thin JVM +
# AOT cache 105 ms, and the Kotlin/Native client 7.0 ms, against a 0.9 ms
# fork+exec floor. On the 78-file compiler profile that is 3.9% -> 0.1%; on a
# 3-file project - the request an editor actually generates - it is the
# difference between 376 ms and 98 ms, i.e. THREE QUARTERS of the wait.
#
# THE FALLBACK IS THE POINT, not a courtesy. The native client depends on `-api`
# and nothing else, so it CANNOT compile: with no daemon reachable and none
# startable it exits XTSC_CLIENT_UNAVAILABLE (3) rather than pretending. That
# code is documented to mean "the request never ran" - never "it ran and found
# errors" - so it is safe to re-run here, and re-running is what keeps `xtsc`
# working on a fresh checkout, after a `clean`, and on any platform with no
# native binary. Round 857 found the launcher inoperable for a whole window
# because it depended on an artifact only one task creates; nothing here may
# depend on the native binary existing.
XTSC_RESOLVED_CLIENT=""
xtsc_resolve_client() {
  # `off` is a real setting, not a debugging leftover: the A/B harnesses and the
  # pins need to force the JVM arm on a box where the native binary exists.
  if [ -n "${XTSC_CLIENT:-}" ]; then
    [ "$XTSC_CLIENT" = "off" ] && return 1
    [ -x "$XTSC_CLIENT" ] || return 1
    XTSC_RESOLVED_CLIENT="$XTSC_CLIENT"
    return 0
  fi
  if [ -n "${XTSC_HOME:-}" ] && [ -x "${XTSC_HOME%/}/bin/xtsc-client" ]; then
    XTSC_RESOLVED_CLIENT="${XTSC_HOME%/}/bin/xtsc-client"
    return 0
  fi
  local c
  for c in "$XTSC_SCRIPT_DIR"/../xemantic-typescript-compiler-client/build/bin/*/releaseExecutable/*.kexe; do
    if [ -x "$c" ]; then XTSC_RESOLVED_CLIENT="$c"; return 0; fi
  done
  return 1
}

xtsc_is_daemon_request=0
for arg in "$@"; do
  if [ "$arg" = "--daemon" ]; then xtsc_is_daemon_request=1; break; fi
done

# XTSC_AOT_DECIDE_ONLY is a probe of the AOT decision, which is a property of the
# JVM arm; answering it from the native arm would report on something the caller
# is not asking about. Round 871's client harness uses it, so this also keeps
# that measurement meaning what its own header says.
if [ "$xtsc_is_daemon_request" -eq 1 ] && [ -z "${XTSC_AOT_DECIDE_ONLY:-}" ] && xtsc_resolve_client; then
  [ -n "${XTSC_CLIENT_VERBOSE:-}" ] && printf 'xtsc: client native %s\n' "$XTSC_RESOLVED_CLIENT" >&2
  if [ -n "${XTSC_CLIENT_DECIDE_ONLY:-}" ]; then printf 'native %s\n' "$XTSC_RESOLVED_CLIENT"; exit 0; fi

  # --no-spawn IS THE POINT, and it is what keeps this a LATENCY change and
  # nothing else. The thin client's own default is to START a daemon when it
  # finds none, which is right for a binary invoked as `xtsc`, and WRONG as a
  # side effect of swapping an arm: `--daemon` has always meant "use a server if
  # one is up, else compile here and say so", and auto-spawn would silently
  # replace an in-process compile with a long-lived JVM the user never asked
  # for. It is not a hypothetical — the first build of this arm spawned one from
  # inside the 14,000-test suite, where `AotCacheGuardTest` caught it and a
  # daemon was left running afterwards.
  #
  # So: identical semantics on every path, and the win is unaffected, because
  # the case this round is about (an editor, a warm daemon) has one running
  # already. Auto-spawn is a product decision that deserves its own round.
  xtsc_client_args=(--no-spawn)
  for arg in "$@"; do
    [ "$arg" = "--daemon" ] || xtsc_client_args+=("$arg")
  done
  # The two peers derive the socket path INDEPENDENTLY, in common code, and a
  # disagreement does not fail - it silently starts a second daemon. They differ
  # in exactly one respect: the client honours XTSC_SOCKET and the JVM
  # dispatcher does not. Naming it explicitly here is what keeps the arms
  # interchangeable; deriving the default path in bash would add a THIRD
  # derivation, which is the thing the invariant forbids.
  case " $* " in
    *" --socket "*) ;;
    *) [ -n "${XTSC_SOCKET:-}" ] && xtsc_client_args=(--socket "$XTSC_SOCKET" ${xtsc_client_args[@]+"${xtsc_client_args[@]}"}) ;;
  esac
  # stderr is held back rather than streamed: on a fallback the client has
  # already explained that it found no daemon, and printing that above a compile
  # that then succeeds is worse than saying nothing. Diagnostics are on STDOUT
  # and are not touched, so nothing a user reads is buffered.
  xtsc_client_err="$(mktemp "${TMPDIR:-/tmp}/xtsc-client-err.XXXXXX")"
  set +e
  "$XTSC_RESOLVED_CLIENT" ${xtsc_client_args[@]+"${xtsc_client_args[@]}"} 2>"$xtsc_client_err"
  xtsc_client_code=$?
  set -e
  if [ "$xtsc_client_code" -ne 3 ]; then
    cat "$xtsc_client_err" >&2
    rm -f "$xtsc_client_err"
    exit "$xtsc_client_code"
  fi
  [ -n "${XTSC_CLIENT_VERBOSE:-}" ] && cat "$xtsc_client_err" >&2
  rm -f "$xtsc_client_err"
  # ... and fall through to the JVM arm, which can compile in-process.
fi

# Answered here rather than beside the native branch so that BOTH outcomes are
# observable through one hook: a pin that can only see the arm it expects cannot
# tell "chose the JVM" from "the hook did not fire".
if [ -n "${XTSC_CLIENT_DECIDE_ONLY:-}" ]; then printf 'jvm\n'; exit 0; fi

xtsc_resolve_classpath || xtsc_die "cannot resolve a classpath - set XTSC_CP or XTSC_HOME, or build this repo first"

decision="$(xtsc_aot_decide "$XTSC_RESOLVED_CP" "$XTSC_MAIN_CLASS")"
[ -n "${XTSC_AOT_VERBOSE:-}" ] && printf 'xtsc: aot %s\n' "$decision" >&2

# A hook for the seam pins: report the decision and launch nothing.
if [ -n "${XTSC_AOT_DECIDE_ONLY:-}" ]; then
  printf '%s\n' "$decision"
  exit 0
fi

jvm_flags=()
case "$decision" in
  USE\ *)
    while IFS= read -r flag; do jvm_flags+=("$flag"); done < <(xtsc_aot_jvm_flags "${decision#USE }")
    ;;
esac

# shellcheck disable=SC2206
extra=(${XTSC_JAVA_OPTS:--Xmx4g})

exec "${XTSC_JAVA:-java}" ${jvm_flags[@]+"${jvm_flags[@]}"} "${extra[@]}" \
  -cp "$XTSC_RESOLVED_CP" "$XTSC_MAIN_CLASS" "$@"
