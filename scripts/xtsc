#!/usr/bin/env bash
#
# xtsc - the guarded launcher.
#
# Runs the TypeScript compiler on the JVM, using the JDK 25 AOT cache when - and
# ONLY when - that cache's provenance is fully verified against the classpath it
# was trained from. See scripts/xtsc-aot-lib.sh for the contract and
# docs/perf/aot-cache.md for the measurements and the residual risks.
#
#   scripts/xtsc --noEmit /path/to/project        # normal use
#   scripts/xtsc --serve --socket /tmp/x.sock     # run the compile server
#   scripts/xtsc --daemon --socket /tmp/x.sock …  # send a request to one
#   scripts/xtsc-aot train /path/to/project       # create the cache
#   XTSC_AOT=off scripts/xtsc ...                 # never use a cache
#   XTSC_AOT_VERBOSE=1 scripts/xtsc ...           # print the decision to stderr
#
# Environment: XTSC_CP (explicit classpath), XTSC_HOME (a distribution root with
# lib/*.jar), XTSC_AOT_DIR (cache location, default $XDG_CACHE_HOME/xtsc),
# XTSC_JAVA (java binary), XTSC_JAVA_OPTS (extra JVM flags, default -Xmx4g).
set -euo pipefail

XTSC_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/xtsc-aot-lib.sh
. "$XTSC_SCRIPT_DIR/xtsc-aot-lib.sh"

# The DISPATCHING entry point, not the plain one-shot `…compiler.MainKt`: its
# `main` is a strict superset that adds `--serve` (run the compile server) and
# `--daemon` (send the request to one, falling back to compiling in-process) and
# otherwise delegates to `…compiler.main(args)` verbatim. Round 839 found the
# launcher could not reach either mode; its `--serve` arm had to be run by
# invoking `java` by hand.
#
# This constant is inside the AOT fingerprint (`mainclass` in
# xtsc_fingerprint_block), so it MUST stay identical to scripts/xtsc-aot's —
# a half-swap makes every launch read `SKIP no-cache-file` and silently run
# uncached forever. AotCacheGuardTest pins the two against each other.
XTSC_MAIN_CLASS="com.xemantic.typescript.compiler.server.XtscMainKt"

xtsc_resolve_classpath || xtsc_die "cannot resolve a classpath - set XTSC_CP or XTSC_HOME, or build this repo first"

decision="$(xtsc_aot_decide "$XTSC_RESOLVED_CP" "$XTSC_MAIN_CLASS")"
[ -n "${XTSC_AOT_VERBOSE:-}" ] && printf 'xtsc: aot %s\n' "$decision" >&2

# A hook for the seam pins: report the decision and launch nothing.
if [ -n "${XTSC_AOT_DECIDE_ONLY:-}" ]; then
  printf '%s\n' "$decision"
  exit 0
fi

jvm_flags=()
case "$decision" in
  USE\ *)
    while IFS= read -r flag; do jvm_flags+=("$flag"); done < <(xtsc_aot_jvm_flags "${decision#USE }")
    ;;
esac

# shellcheck disable=SC2206
extra=(${XTSC_JAVA_OPTS:--Xmx4g})

exec "${XTSC_JAVA:-java}" ${jvm_flags[@]+"${jvm_flags[@]}"} "${extra[@]}" \
  -cp "$XTSC_RESOLVED_CP" "$XTSC_MAIN_CLASS" "$@"
